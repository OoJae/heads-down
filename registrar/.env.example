# Heads Down registrar configuration. Copy to .env (git-ignored) and fill in.
# Every variable is optional unless marked REQUIRED. Values shown are the defaults, except
# where a comment says otherwise. A test in src/config.rs keeps this list equal to what the
# code reads.

# --- Secrets (REQUIRED; never commit) --------------------------------------------------------
# HMAC key for session tokens, >= 32 bytes, hex or base64. Generate: openssl rand -hex 32
HD_SESSION_SECRET=
# Registrar Ed25519 key: a Solana CLI keypair file (create with `hd-registrar keygen <path>`)...
HD_REGISTRAR_KEYPAIR=./data/registrar-keypair.json
# ...or its base58 secret instead (set only one of the two).
# HD_REGISTRAR_SECRET_B58=

# --- The app being attested ------------------------------------------------------------------
HD_APP_PACKAGE=xyz.headsdown
# One of the next two is REQUIRED: with both empty the registrar exits at start
# ("configuration error: HD_APP_RELEASE_CERT_SHA256 is required", exit code 2).
#
# SHA-256 of the release signing certificate(s), hex, comma-separated
# (apksigner verify --print-certs, or the Play Console "App signing key certificate").
HD_APP_RELEASE_CERT_SHA256=
# SHA-256 of a debug signing certificate, in the same format. Setting it, with
# HD_APP_RELEASE_CERT_SHA256 left unset, is how a debug-signed build is accepted on the
# operator's own phone. What it means: the registrar then vouches for any build signed with
# that debug key, and anyone who holds the keystore can sign one (the Android debug keystore's
# password is a public default). The service warns at start, /registrar reports
# debug_signers_accepted=true and such vouchers are logged with "signer": "debug". Remove it
# before anyone else installs the app.
# HD_APP_DEBUG_CERT_SHA256=
# reject | level0 (vouch at level 0 "unattested" instead of refusing)
HD_SOFTWARE_KEY_POLICY=reject
HD_UNLOCKED_DEVICE_POLICY=reject

# --- Program / chain -------------------------------------------------------------------------
HD_PROGRAM_ID=HDn4vgLWFLLdexKEwfZwRHjWtizNvdqFteLbMsE67F9p
# Optional. Used for one call only, the finalized slot a voucher's expiry is counted from: one
# getSlot per attestation, cached for 5 seconds, and one at start, after which the log says
# whether a slot came ("slot source answered", or the warning "slot source gave no slot").
# Without a slot every attestation answers 503 slot_unavailable while /healthz stays 200. A
# provider URL with an API key in it works too: the registrar never logs the URL.
# The default is the public mainnet RPC. It is not to be counted on from a hosting provider:
# see deploy/railway/registrar/.env.example.
HD_RPC_URL=https://api.mainnet-beta.solana.com
# About 20 days at today's slot time (about 270 ms a slot; the number was chosen as 30 days at
# 400 ms). At most 25920000: the program refuses a longer voucher.
HD_VOUCHER_TTL_SLOTS=6480000
# Development only, must stay unset in production: a constant instead of the cluster's slot,
# so every voucher's expiry is counted from that constant.
# HD_FIXED_SLOT=

# --- Sign-In-With-Solana ---------------------------------------------------------------------
# REQUIRED, no default: the host of the site the app identifies itself with (the app build's
# headsdown.identityUri). It must be a site the team controls: the wallet shows it in every
# sign-in prompt.
HD_SIWS_DOMAIN=oojae.github.io
# That site's URL. It is compared character for character with the URI in the message the
# wallet signs. Default: https://<HD_SIWS_DOMAIN>. The project's page is under a path, so it is
# set here, with its trailing slash.
HD_SIWS_URI=https://oojae.github.io/heads-down/
# Comma-separated CAIP-2 ids; use solana:devnet for devnet builds.
HD_SIWS_CHAINS=solana:mainnet
HD_SIWS_STATEMENT=Sign in to Heads Down.
HD_NONCE_TTL_SECS=600
HD_SESSION_TTL_SECS=3600
# memory | sqlite:<path>. The default is memory, which forgets outstanding nonces on a restart.
HD_NONCE_STORE=sqlite:./data/nonces.db
HD_MAX_OUTSTANDING_NONCES=100000

# --- Revocation status list ------------------------------------------------------------------
HD_STATUS_LIST_URL=https://android.googleapis.com/attestation/status
HD_STATUS_TTL_SECS=3600
# After this long without a successful refresh, /attest fails closed (503).
HD_STATUS_MAX_STALE_SECS=172800
# Development only, must stay unset in production: a local JSON file instead of the URL. It is
# read once at start and never refreshed, so later revocations are not seen.
# HD_STATUS_LIST_FILE=./testdata/status/status_live_sample.json

# --- Service ---------------------------------------------------------------------------------
HD_BIND=0.0.0.0:8080
HD_TRANSPARENCY_LOG=./data/attestations.jsonl
HD_RATE_LIMIT_PER_MIN=60
HD_RATE_LIMIT_BURST=20
HD_ATTEST_RATE_LIMIT_PER_MIN=6
HD_ATTEST_RATE_LIMIT_BURST=3
# Which address the rate limits are keyed on. By default the TCP peer, which is right when
# clients connect directly. Behind a reverse proxy set ONE of the next two, whichever names the
# header that proxy writes (with both set the registrar exits at start):
# - true: the address in X-Real-IP, for a proxy that sets it on every request (Railway documents
#   it as the client's address). Written true or false, in lower case.
HD_TRUST_REAL_IP=false
# - n: the n-th address from the right of X-Forwarded-For, for n trusted proxies that each append
#   the address they saw. 0 ignores the header.
HD_TRUSTED_PROXY_HOPS=0
HD_MAX_BODY_BYTES=65536
HD_MAX_CONCURRENT_ATTEST=4
HD_REQUEST_TIMEOUT_SECS=20
# json | pretty
HD_LOG_FORMAT=json
# Log filter (tracing EnvFilter syntax). Unset, the filter is info,tower_http=warn.
RUST_LOG=info
