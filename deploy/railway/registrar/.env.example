# hd-registrar on Railway: every variable the service and its entrypoint read
# (registrar/src/config.rs, where a test keeps this list equal to what the code reads, and
# deploy/railway/registrar/entrypoint.sh). Names only for secrets: never put a real value in
# this file. Values shown are the code's defaults, except where a comment says otherwise.

# ---- secrets: add as SEALED variables -----------------------------------------------------------
# The voucher key: the whole contents of ~/.config/heads-down/mainnet/registrar.json (made by
# `hd-registrar keygen`; its public key is Config.registrar). The entrypoint writes it to a 0600
# file on tmpfs, sets HD_REGISTRAR_KEYPAIR to it, and deletes the file once the service has
# loaded it.
HD_REGISTRAR_KEYPAIR_JSON=
# Alternative to the above (base58 secret); set only one of the two.
# HD_REGISTRAR_SECRET_B58=
# HMAC key for SIWS session tokens, >= 32 bytes, hex or base64: the contents of
# ~/.config/heads-down/mainnet/registrar-session-secret.
HD_SESSION_SECRET=

# ---- RPC -------------------------------------------------------------------------------------------
# Optional. The registrar makes one call, the finalized slot a voucher's expiry is counted from:
# one getSlot per attestation, cached for 5 seconds. Unset, it asks the public mainnet RPC
# (https://api.mainnet-beta.solana.com). Leave it unset on Railway: the Helius key then stays
# out of this service, and attestation does not use the Helius credits. Not tested from
# Railway: whether the public RPC rate-limits its addresses (a failed call answers 503
# slot_unavailable).
# If a keyed URL is set after all, seal this variable too: a variable that carries the key, or
# a URL with the key in it, must itself be sealed. The registrar never logs the URL.
# HD_RPC_URL=

# ---- the app being attested ------------------------------------------------------------------------
# One of the two digest variables must be set: with both empty the registrar exits at start
# ("configuration error: HD_APP_RELEASE_CERT_SHA256 is required", exit code 2).
#
# SHA-256 of the release signing certificate(s), hex, comma-separated
# (apksigner verify --print-certs, or the Play Console "App signing key certificate").
# Leave it unset while only debug-signed builds exist.
HD_APP_RELEASE_CERT_SHA256=
# SHA-256 of a debug signing certificate, in the same format. Setting it, with
# HD_APP_RELEASE_CERT_SHA256 left unset, is how a debug-signed build is accepted on the
# operator's own phone:
#   apksigner verify --print-certs android/app/build/outputs/apk/debug/app-debug.apk
# What it means: the registrar then vouches for any build signed with that debug key, and anyone
# who holds the keystore can sign one (the Android debug keystore's password is a public
# default). The service warns at start, /registrar reports debug_signers_accepted=true and such
# vouchers are logged with "signer": "debug". Remove it before anyone else installs the app.
# HD_APP_DEBUG_CERT_SHA256=
HD_APP_PACKAGE=xyz.headsdown
# reject | level0
HD_SOFTWARE_KEY_POLICY=reject
HD_UNLOCKED_DEVICE_POLICY=reject

# ---- program / chain -----------------------------------------------------------------------------
HD_PROGRAM_ID=HDn4vgLWFLLdexKEwfZwRHjWtizNvdqFteLbMsE67F9p
# About 20 days at today's slot time (about 270 ms a slot; the number was chosen as 30 days at
# 400 ms). At most 25920000: the program refuses a longer voucher.
HD_VOUCHER_TTL_SLOTS=6480000

# ---- Sign-In-With-Solana ---------------------------------------------------------------------------
# REQUIRED, no default: the host of the site the app identifies itself with (the app build's
# headsdown.identityUri). It must be a site the team controls, never a name somebody else can
# register.
HD_SIWS_DOMAIN=oojae.github.io
# That site's URL. It is compared character for character with the URI in the message the
# wallet signs. Default: https://<HD_SIWS_DOMAIN>. The project's page is under a path, so it is
# set here, with its trailing slash.
HD_SIWS_URI=https://oojae.github.io/heads-down/
HD_SIWS_CHAINS=solana:mainnet
HD_SIWS_STATEMENT=Sign in to Heads Down.
HD_NONCE_TTL_SECS=600
HD_SESSION_TTL_SECS=3600
HD_MAX_OUTSTANDING_NONCES=100000

# ---- revocation status list --------------------------------------------------------------------------
HD_STATUS_LIST_URL=https://android.googleapis.com/attestation/status
HD_STATUS_TTL_SECS=3600
HD_STATUS_MAX_STALE_SECS=172800

# ---- service -------------------------------------------------------------------------------------------
# Railway routes the public domain to this port; the entrypoint binds [::]:$PORT (or 0.0.0.0).
PORT=8080
# Which address the rate limits are keyed on. Railway's edge sets X-Real-IP to the client's
# remote address (Railway docs, Networking > Specs & Limits; X-Forwarded-For is not in that
# list), so the limits key on that header, like the crank's. The code's default is false (the
# TCP peer, which on Railway is the edge). Not run against Railway yet; check it after a deploy:
#   seq 60 | xargs -P 20 -I{} curl -s -o /dev/null -w '%{http_code}\n' https://<registrar host>/registrar | sort | uniq -c
#     -> about 20 answers 200, the rest 429 (burst 20, then one a second)
#   curl -s -o /dev/null -w '%{http_code}\n' -H 'X-Real-IP: 203.0.113.9' https://<registrar host>/registrar
#     -> still 429. A 200 means a caller can choose its own bucket: set this to false and report it.
HD_TRUST_REAL_IP=true
# The other proxy setting: the n-th address from the right of X-Forwarded-For. Leave it at 0
# here: the two name different headers, and with both set the registrar exits at start.
# HD_TRUSTED_PROXY_HOPS=0
# On the Railway volume mounted at /data (the entrypoint refuses to start on Railway without
# it; the code's defaults are memory and ./data/attestations.jsonl). Back up attestations.jsonl:
# it is append-only, hash-chained and meant to be mirrored publicly.
HD_NONCE_STORE=sqlite:/data/nonces.db
HD_TRANSPARENCY_LOG=/data/attestations.jsonl
HD_RATE_LIMIT_PER_MIN=60
HD_RATE_LIMIT_BURST=20
HD_ATTEST_RATE_LIMIT_PER_MIN=6
HD_ATTEST_RATE_LIMIT_BURST=3
HD_MAX_BODY_BYTES=65536
HD_MAX_CONCURRENT_ATTEST=4
HD_REQUEST_TIMEOUT_SECS=20
HD_LOG_FORMAT=json
# Log filter (tracing EnvFilter syntax). The image sets info; unset, it is info,tower_http=warn.
RUST_LOG=info
# Derived from PORT by the entrypoint unless set.
# HD_BIND=[::]:8080

# ---- development overrides: must stay UNSET in production ------------------------------------------
# HD_FIXED_SLOT puts a constant in place of the cluster's slot, so every voucher's expiry is
# counted from that constant. HD_STATUS_LIST_FILE puts a local file in place of Google's
# revocation list; it is read once at start and never refreshed, so later revocations are not
# seen.
# HD_FIXED_SLOT=
# HD_STATUS_LIST_FILE=
