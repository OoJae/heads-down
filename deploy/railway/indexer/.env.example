# Heads Down indexer on Railway: every variable the service reads (services/indexer/src/config.ts;
# services/indexer/test/config.test.ts fails when this list and the code disagree).
# Names only for secrets: never put a real value in this file.

# ---- secrets (sealed) / references ---------------------------------------------------------------
# Railway Postgres (the PostgreSQL template service, named "Postgres"): reference its private URL,
#   ${{Postgres.DATABASE_URL}}
# (postgresql://…@postgres.railway.internal:5432/railway, private network, no egress fees).
DATABASE_URL=
# Mainnet RPC, keyed: https://mainnet.helius-rpc.com/?api-key=${{shared.HELIUS_API_KEY}}
# Its genesis hash is checked before the first poll. While that check fails (wrong cluster, RPC down,
# credits used up) nothing is ingested, the check is tried again every INGEST_INTERVAL_S, and the API
# keeps serving what is stored. Only the URL's host is ever logged.
# Left unset: no chain ingestion and no RPC call at all, so no RPC credits are used. ORE rounds still
# come from api.ore.com (ORE_API_ENABLED), and the API serves what is stored.
RPC_URL=
# Optional Helius raw webhook (>= 16 chars); payloads are re-fetched from RPC_URL unless TRUST=1.
# HELIUS_WEBHOOK_SECRET=
# HELIUS_WEBHOOK_TRUST_PAYLOAD=0

# ---- dataset ---------------------------------------------------------------------------------------
# mainnet | devnet | localnet | simulated (the API serves exactly one).
INDEXER_DATASET=mainnet
# Default: the pinned HDn4vgLWFLLdexKEwfZwRHjWtizNvdqFteLbMsE67F9p
# HEADS_DOWN_PROGRAM_ID=

# ---- service -----------------------------------------------------------------------------------------
# 0.0.0.0 for Railway's public domain; "::" if another service must reach it over private networking.
HOST=0.0.0.0
PORT=8080
# The dashboard's origin (https://<dashboard domain>), or * for a public read-only API.
CORS_ORIGIN=*
# Night/hour bucketing offset in minutes (60 = WAT).
NIGHT_TZ_OFFSET_MINUTES=60
# The team crank's fee payer(s), comma-separated: crank-payer.json's public key. Third-party
# cranks are everything else (ORE milestone M3).
TEAM_CRANKERS=
# Market price for the morning haul, tried in order (jupiter = Jupiter Price API v3,
# ore-api = api.ore.com /market), or none. Neither uses RPC_URL.
MARKET_PRICE_SOURCES=jupiter,ore-api

# ---- ingestion and its RPC use -----------------------------------------------------------------------
# Seconds between ingest passes (the code's default is 30; 0 = no polling). The dashboard and the
# morning haul lag by up to this long. INGEST_INTERVAL_S=300 is the value between test sessions on
# Helius' free plan (1M credits a month, shared with the crank and the registrar); set 30 to 60
# while recording a demo.
# What a pass costs at Helius' prices (getProgramAccounts 10 credits, every other call 1): 2 calls
# to look for new signatures, 1 per new transaction, the snapshot below when it is due, and the ORE
# spot-check and round resolver further down.
INGEST_INTERVAL_S=300
# The account snapshot is four getProgramAccounts scans (40 credits). It is taken on the first poll
# after start, on every poll that finds a new transaction that succeeded, and otherwise every Nth
# poll as a safety net (1 = every poll, as before this setting existed). 20 polls is 100 minutes
# at INGEST_INTERVAL_S=300 and 10 minutes at 30.
SNAPSHOT_EVERY_N_POLLS=20
# First run only: how many recent signatures per address to read back.
RPC_MAX_BACKFILL=5000
# ORE rounds from api.ore.com (no RPC needed), spot-checked against the chain when RPC_URL is set:
# up to ORE_API_VERIFY_SAMPLE getTransaction calls per pass (0 = none).
ORE_API_ENABLED=1
# ORE_ROUNDS_SINCE=<unix seconds>   (default: 14 days ago)
ORE_API_VERIFY_SAMPLE=3
# ORE round resolver over RPC_URL (0 = off): the Round account and, where api.ore.com has not
# delivered it, the reset transaction of each round a rig dug in. No RPC call while no round is waiting.
RESOLVE_ROUNDS=1
# Round accounts and reset transactions looked up per pass.
RESOLVE_MAX_ROUNDS=200
RESOLVE_RESET_LOOKUPS=10
