{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/crank/Dockerfile",
    "watchPatterns": ["/crank/**", "/crates/p256-introspect/**", "/deploy/railway/crank/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "requiredMountPath": "/data",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 20
  }
}
