# hd-crank on Railway: every variable the service reads. Names only for secrets: never put a
# real value in this file. Set them in the Railway service's Variables tab (docs/DEPLOY.md).

# ---- secrets: add as SEALED variables -----------------------------------------------------------
# The crank fee payer: the whole contents of ~/.config/heads-down/mainnet/crank-payer.json
# (a JSON array of 64 numbers). The entrypoint writes it to a 0600 file on tmpfs, removes it from
# hd-crank's environment, and deletes the file as soon as hd-crank has loaded it.
HD_CRANK_KEYPAIR_JSON=
# Helius API key: reference the project's shared variable, i.e. set the value to
#   ${{shared.HELIUS_API_KEY}}
# hd-crank substitutes it for {HELIUS_API_KEY} in the RPC and WebSocket URLs of crank.toml and
# never logs the URL (only scheme and host). An empty value stops the crank at start with
# "HELIUS_API_KEY is set to an empty value".
HELIUS_API_KEY=

# ---- service -------------------------------------------------------------------------------------
# Port for /ws (heartbeat intake), /healthz and /metrics. Set it so the public domain's target
# port is stable; the entrypoint listens on [::]:$PORT (dual-stack) or 0.0.0.0:$PORT.
PORT=8787
# tracing EnvFilter.
RUST_LOG=info,hyper=warn,reqwest=warn

# ---- one phone on Helius' free plan (uncomment all six) ------------------------------------------
# The free plan is 1,000,000 credits a month: getProgramAccounts costs 10, every other call 1.
# With crank.toml as baked into the image, an idle crank asks for about 108,500 credits a day,
# most of it scans for things a test with one or two phones does not have. With these six
# overrides it asks for about 30,500 a day (computed from the code: crank/README.md, "RPC
# budget", has the table and what was measured). A night with a phone heads down costs more:
# see there.
#
# No lookup table. One or two rigs fit a transaction without one, no table rent is locked
# (2,560,320 lamports, more per rig), and the rig scan every 30 s that fills the table stops.
# HD_CRANK_ALT_ENABLED=false
# No Stack check-ins or settles. Nobody is seated at a Stack table yet, and looking for tables
# scans the program twice every 30 s.
# HD_CRANK_STACK_ENABLED=false
# Never pay the Bury vault's rent (3,114,040 lamports, once, never returned). With Stack and
# cleanups off nothing asks for it; this keeps it that way if one of them is turned back on.
# HD_CRANK_STACK_INIT_BURY_VAULT=false
# No sealing of other people's stale shifts. The app seals its own shift at clock-out and at
# the next clock-in; this saves a scan a minute and 1,300,480 lamports of rent per sealed shift.
# HD_CRANK_END_SHIFT_ENABLED=false
# No Focus Bond forfeits and no gift refunds by this crank. A one-phone test has neither, and
# the sweep scans the program twice every 5 minutes.
# HD_CRANK_CLEANUP_ENABLED=false
# At most one rig lookup a second for heartbeats that name a rig the crank has not read yet
# (default 50). Anyone can send such frames, and each lookup is a credit. A phone's first
# heartbeat after it arms needs one lookup; while they are used up it is answered rate_limited.
# HD_CRANK_INTAKE_RIG_FETCHES_PER_SECOND=1

# ---- optional overrides (defaults: /etc/hd-crank/crank.toml in the image) ------------------------
# Every setting of crank.toml has a variable, HD_CRANK_<SECTION>_<FIELD>; `hd-crank config --env`
# lists them all. A name that is not a setting is reported in the log at start.
# Another RPC; keep {HELIUS_API_KEY} as the placeholder, never a literal key.
# HD_CRANK_RPC_URL=https://mainnet.helius-rpc.com/?api-key={HELIUS_API_KEY}
# HD_CRANK_WS_URL=wss://mainnet.helius-rpc.com/?api-key={HELIUS_API_KEY}
# legacy | v0 | v1
# HD_CRANK_TX_FORMAT=v0
# Listen address (default: derived from PORT by the entrypoint).
# HD_CRANK_LISTEN=[::]:8787
# Another config file baked into the image.
# HD_CRANK_CONFIG=/etc/hd-crank/crank.toml
# Once the log shows "created lookup table", pin it: the table then comes from configuration,
# and nothing that happens to the volume can make the crank create another.
# HD_CRANK_ALT_TABLES=<the table's address>
# HD_CRANK_ALT_AUTO_CREATE=false
# Seconds between the chain watcher's HTTP polls beside the WebSocket (1..=20; crank.toml: 15).
# HD_CRANK_CHAIN_POLL_SECS=15
# While idle, one dig pass in this many rounds still reads the chain (0 = every pass reads).
# HD_CRANK_DIG_IDLE_FULL_READ_ROUNDS=10
