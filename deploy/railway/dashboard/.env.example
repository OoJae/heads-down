# Heads Down dashboard on Railway. The site has no secrets.

# ---- build time (inlined into the static pages) ----------------------------------------------------
# REQUIRED: the indexer's public base URL: https://<host> and nothing else (a port and one
# trailing "/" are allowed). The build fails on an empty value, a bare "https://", a path, or a
# "?", an "@" or "api-key" anywhere in it: whatever this holds is published in the site's
# JavaScript, so it must never be a URL with a key in it. With a Railway domain on the indexer
# service, reference it:
#   https://${{indexer.RAILWAY_PUBLIC_DOMAIN}}
# Generate the indexer's domain before the dashboard's first build. A change needs a rebuild
# (redeploy), not just a restart.
NEXT_PUBLIC_HD_API_BASE=

# ---- runtime (server.mjs) ---------------------------------------------------------------------------
# Railway routes the public domain here; server.mjs listens on [::] (or 0.0.0.0).
PORT=8080
# Where the export lives inside the image.
DASHBOARD_ROOT=/app/out
