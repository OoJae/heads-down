{
  "name": "@heads-down/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Heads Down indexer: heads_down program events, ORE DeployEvents signed by the Heads Down Executor PDA, Rig/ShiftLog/SeekerSeat accounts and ORE rounds into Postgres, plus a public read API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "start": "node src/main.ts serve",
    "ingest": "node src/main.ts ingest",
    "simulate": "node src/main.ts simulate",
    "migrate": "node src/main.ts migrate",
    "demo": "node src/main.ts demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@solana/addresses": "8.4.0",
    "@solana/codecs-strings": "8.4.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
