# Copy to .env (gitignored) or set in the host's environment. Never commit real values.

# postgres://user:pass@host:5432/db  (docker compose: postgres://headsdown:headsdown-dev@127.0.0.1:54329/headsdown)
# or pglite://.data/pg for an embedded Postgres with no Docker.
DATABASE_URL=pglite://.data/pg

# Which dataset this process reads/writes: mainnet | devnet | localnet | simulated
INDEXER_DATASET=simulated

# Defaults to the pinned HDn4vgLWFLLdexKEwfZwRHjWtizNvdqFteLbMsE67F9p
# HEADS_DOWN_PROGRAM_ID=

# Secret-bearing (may embed an API key). Its genesis hash is checked before the first poll and
# nothing is ingested until it matches the dataset's cluster; a failed check is tried again every
# INGEST_INTERVAL_S. Unset: no chain ingestion and no RPC call (ORE rounds still come from api.ore.com).
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# Optional Helius raw webhook (>= 16 chars). Payloads are re-fetched from RPC_URL unless TRUST=1.
# HELIUS_WEBHOOK_SECRET=
# HELIUS_WEBHOOK_TRUST_PAYLOAD=0

HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=*
# Night/hour bucketing offset in minutes (60 = WAT)
NIGHT_TZ_OFFSET_MINUTES=60
# Comma-separated fee payers run by the Heads Down team (to count third-party cranks)
TEAM_CRANKERS=
# Seconds between ingest passes (0 = no polling). Each pass looks for new signatures with two RPC calls.
INGEST_INTERVAL_S=30
# Account snapshot (four getProgramAccounts scans): on the first poll after start, on every poll that
# finds a new transaction that succeeded, and otherwise every Nth poll as a safety net (1 = every poll).
SNAPSHOT_EVERY_N_POLLS=20
RPC_MAX_BACKFILL=5000
# ORE rounds from api.ore.com (mainnet only, no RPC needed). A first start reads back to ORE_ROUNDS_SINCE,
# at most ORE_API_PAGES_PER_PASS requests a pass (100 rounds a page, a second apart): 14 days are 18 to 22
# passes. A later ORE_ROUNDS_SINCE reads less. README, "ORE rounds from api.ore.com".
ORE_API_ENABLED=1
# ORE_ROUNDS_SINCE=<unix seconds>   (default: 14 days ago)
ORE_API_PAGES_PER_PASS=10
ORE_API_VERIFY_SAMPLE=3
# Market price for the morning haul, tried in order (jupiter = Jupiter Price API v3, ore-api = api.ore.com /market), or none.
MARKET_PRICE_SOURCES=jupiter,ore-api
# ORE round resolver over RPC: Round accounts (exact per-square totals) and reset transactions.
RESOLVE_ROUNDS=1
RESOLVE_MAX_ROUNDS=200
RESOLVE_RESET_LOOKUPS=10
