# Copy to .env (gitignored) or set in the host's environment. Never commit real values.

# postgres://user:pass@host:5432/db  (docker compose: postgres://headsdown:headsdown-dev@127.0.0.1:54329/headsdown)
# or pglite://.data/pg for an embedded Postgres with no Docker.
DATABASE_URL=pglite://.data/pg

# Which dataset this process reads/writes: mainnet | devnet | localnet | simulated
INDEXER_DATASET=simulated

# Defaults to the pinned HDn4vgLWFLLdexKEwfZwRHjWtizNvdqFteLbMsE67F9p
# HEADS_DOWN_PROGRAM_ID=

# Secret-bearing (may embed an API key). Checked against the cluster's genesis hash at startup.
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# Optional Helius raw webhook (>= 16 chars). Payloads are re-fetched from RPC_URL unless TRUST=1.
# HELIUS_WEBHOOK_SECRET=
# HELIUS_WEBHOOK_TRUST_PAYLOAD=0

HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=*
# Night/hour bucketing offset in minutes (60 = WAT)
NIGHT_TZ_OFFSET_MINUTES=60
# Comma-separated fee payers run by the Heads Down team (to count third-party cranks)
TEAM_CRANKERS=
INGEST_INTERVAL_S=30
RPC_MAX_BACKFILL=5000
ORE_API_ENABLED=1
# ORE_ROUNDS_SINCE=<unix seconds>   (default: 14 days ago)
ORE_API_VERIFY_SAMPLE=3
