<?xml version="1.0" encoding="utf-8"?>
<!--
    Static picker preview for Android 12-14 (15+ uses the generated preview): the widget's own
    two-row layout (TallRig in RigWidget.kt) with a hot rig, drawn by hand. Keep the two alike:
    the pit slab and its hairline, five gold lights, the rig word in condensed bold, the seam in
    gold, the haul in gold, the streak in ash.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hd_widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="15dp"
    android:paddingVertical="11dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@color/hd_widget_gold" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="2dp"
            android:background="@color/hd_widget_gold" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="2dp"
            android:background="@color/hd_widget_gold" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="2dp"
            android:background="@color/hd_widget_gold" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="2dp"
            android:background="@color/hd_widget_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/hd_widget_preview_brand"
            android:textColor="@color/hd_widget_ash_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:text="@string/hd_widget_preview_heat"
        android:textColor="@color/hd_widget_ash"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/hd_widget_preview_dark"
        android:textColor="@color/hd_widget_ash_muted"
        android:textSize="13sp" />

    <!-- the time dark, where the real widget has its chronometer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/hd_widget_preview_time"
        android:textColor="@color/hd_widget_ash"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- the seam: gold light under a hot rig -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginVertical="6dp"
        android:background="@color/hd_widget_gold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="@string/hd_widget_preview_haul"
        android:textColor="@color/hd_widget_gold"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="@string/hd_widget_preview_streak"
        android:textColor="@color/hd_widget_ash_muted"
        android:textSize="12sp" />
</LinearLayout>
