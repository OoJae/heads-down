<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for Android 12-14 (15+ uses the generated preview). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hd_widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/hd_widget_preview_brand"
        android:textColor="@color/hd_widget_ash_muted"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/hd_widget_preview_heat"
        android:textColor="@color/hd_widget_ember"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hd_widget_preview_dark"
        android:textColor="@color/hd_widget_ash"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/hd_widget_preview_footer"
        android:textColor="@color/hd_widget_gold"
        android:textSize="13sp" />
</LinearLayout>
