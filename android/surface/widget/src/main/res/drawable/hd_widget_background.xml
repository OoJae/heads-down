<?xml version="1.0" encoding="utf-8"?>
<!--
    The slab the static picker previews sit on: the pit, a 6dp corner and a hairline around it,
    as WidgetSlab draws the real widget.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hd_widget_charcoal" />
    <stroke
        android:width="1dp"
        android:color="@color/hd_widget_hairline" />
    <corners android:radius="6dp" />
</shape>
