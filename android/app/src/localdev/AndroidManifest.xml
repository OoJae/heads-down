<?xml version="1.0" encoding="utf-8"?>
<!--
    LOCALDEV BUILD TYPE ONLY: loopback cleartext for the local devstack (see the config), the rig
    debug screen (src/devtools) for scripts/devstack/clock-in.sh, and the slab lab. The lab is the
    one thing exported here, and only here: `adb shell am start` opens it on an emulator with a
    pose and a state to screenshot. It reads no extra it could be harmed by and touches no key.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config_localdev">
        <activity
            android:name="xyz.headsdown.devtools.RigDebugActivity"
            android:exported="false"
            android:label="Rig debug"
            android:theme="@style/Theme.HeadsDown" />

        <activity
            android:name="xyz.headsdown.devtools.SlabLabActivity"
            android:exported="true"
            android:label="Slab lab"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HeadsDown" />
    </application>

</manifest>
