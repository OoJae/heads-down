<?xml version="1.0" encoding="utf-8"?>
<!--
    LOCALDEV BUILD TYPE ONLY. Cleartext to exactly 127.0.0.1 and localhost (adb reverse to a
    devstack on the laptop). Everything else stays TLS-only, as in release, which ships no
    network security config and keeps android:usesCleartextTraffic="false".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
