<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Backups: allowBackup=false stops cloud backup, but on Android 12+ it does not stop
        device-to-device transfer, so dataExtractionRules excludes every domain as well.
        Keystore keys are hardware-bound and never leave the device regardless.
    -->
    <application
        android:name=".HeadsDownApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeadsDown"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <!-- The only exported component besides the system-bound tile service. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Clock out: started only by MainActivity, with an explicit intent and no extras. -->
        <activity
            android:name=".clockout.ClockOutActivity"
            android:exported="false" />
    </application>

</manifest>
