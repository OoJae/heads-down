<?xml version="1.0" encoding="utf-8"?>
<!--
    A sheet opens: the whole screen comes up from the bottom edge, over the one that stays.
    The system runs no window animation at all under "Remove animations".
-->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:fromYDelta="100%"
    android:interpolator="@anim/sheet_curve"
    android:toYDelta="0" />
