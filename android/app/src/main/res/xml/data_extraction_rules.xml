<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device: not the (encrypted) MWA token vault, not the heartbeat counter,
    not the shift journal. Keystore key material is hardware-bound and cannot be exported.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
